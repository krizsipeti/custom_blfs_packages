@@ -0,0 +1,24 @@
+#!/bin/bash
+# Wrapper to install GLFS tools using the existing install-blfs-tools.sh implementation.
+# It exports GLFS variables and delegates execution to install-blfs-tools.sh.
+
+set -e
+
+if [ "$1" = auto ]; then
+  if [ -f configuration ]; then
+    source configuration
+  fi
+fi
+
+export BOOK_GLFS=${BOOK_GLFS:-y}
+export GLFS_TOOL=${GLFS_TOOL:-y}
+export GLFS_ROOT=${GLFS_ROOT:-/glfs_root}
+export GLFS_XML=${GLFS_XML:-glfs-xml}
+export GLFS_COMMIT=${GLFS_COMMIT:-trunk}
+export GLFS_BRANCH=${GLFS_BRANCH:-n}
+export GLFS_WORKING_COPY=${GLFS_WORKING_COPY:-n}
+export GLFS_WC_LOCATION=${GLFS_WC_LOCATION:-}
+export GLFS_LFS_BOOK=${GLFS_LFS_BOOK:-}
+export GLFS_LFS_COMMIT=${GLFS_LFS_COMMIT:-trunk}
+
+exec ./install-blfs-tools.sh "$@"
